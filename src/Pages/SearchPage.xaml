<UserControl
    x:Class="LTOG.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG">

    <!-- page-wide keys; the nav buttons carry their own (Alt+Left/Right/Up, Ctrl+S, Ctrl+Shift+F) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="EditAddress_Invoked" />
        <KeyboardAccelerator Modifiers="Menu" Key="D" Invoked="EditAddress_Invoked" />
        <KeyboardAccelerator Key="F4" Invoked="EditAddress_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        <KeyboardAccelerator Modifiers="Menu" Key="Enter" Invoked="Properties_Invoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- filters button while a filter is on -->
        <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search (TextBox's own ✕ clears it) -->
            <TextBox x:Name="SearchBox" PlaceholderText="Search for any file or folder..."
                     FontSize="18" MinHeight="48" Padding="14,11,8,0"
                     AutomationProperties.Name="Search"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown">
                <!-- plain even border: no darker bottom edge, no accent underline on focus -->
                <TextBox.Resources>
                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                </TextBox.Resources>
            </TextBox>

        <!-- back / forward / up, clickable path, filters, export -->
        <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="Back_Click"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="Forward_Click"
                    ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="Up_Click"
                    ToolTipService.ToolTip="Up" AutomationProperties.Name="Up">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <!-- empty area click: edit / copy the full path -->
            <Border x:Name="AddressBar" Grid.Column="3" Margin="4,0" MinHeight="34" CornerRadius="4"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Tapped="AddressBar_Tapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Margin="10,0,2,0" IsHitTestVisible="False" />
                    <StackPanel x:Name="Crumbs" Grid.Column="1" Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center" />
                    <TextBox x:Name="AddressBox" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Path"
                             KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus" />
                </Grid>
            </Border>
            <Button x:Name="FiltersButton" Grid.Column="4" Style="{StaticResource IconButton}" Click="Filters_Click"
                    ToolTipService.ToolTip="Search filters" AutomationProperties.Name="Search filters">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE71C;" FontSize="14" />
            </Button>
            <Button Grid.Column="5" Style="{StaticResource IconButton}" Click="Export_Click"
                    ToolTipService.ToolTip="Export listing (CSV)" AutomationProperties.Name="Export listing">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72D;" FontSize="14" />
            </Button>
        </Grid>

        <!-- columns + tree; column widths must match the row template -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,2" ColumnSpacing="12"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ColumnHeader}" Tag="name" Click="Sort_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Name" />
                            <FontIcon x:Name="NameChevron" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Tag="size" Click="Sort_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Size" />
                            <FontIcon x:Name="SizeChevron" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeader}" Tag="modified" Click="Sort_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Modified" />
                            <FontIcon x:Name="ModifiedChevron" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Tag="location" Click="Sort_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Location" />
                            <FontIcon x:Name="LocationChevron" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView x:Name="List" Grid.Row="1" SelectionMode="Extended"
                          SelectionChanged="List_SelectionChanged" DoubleTapped="List_DoubleTapped"
                          PreviewKeyDown="List_PreviewKeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchRow">
                            <Grid ColumnSpacing="12" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Properties" Tag="{x:Bind}" Click="Properties_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="{x:Bind Indent}" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                                            Opacity="{x:Bind ChevronOpacity}" IsEnabled="{x:Bind HasChildren}"
                                            Tag="{x:Bind}" Click="Chevron_Click" IsTabStop="False"
                                            AutomationProperties.Name="Expand or collapse">
                                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" />
                                    </Button>
                                    <FontIcon Grid.Column="1" Glyph="{x:Bind Icon}" FontSize="16" Opacity="0.85" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Node.Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Node.Path}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind SizeTip}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ModifiedTip}" />
                                <TextBlock Grid.Column="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Node.AllLocations}">
                                    <Run Text="{x:Bind Node.Location}" /><Run Text="{x:Bind Node.MoreLocations}"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No captured indexes yet." Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- status: selected / displayed, and free space across every indexed tape -->
        <Grid Grid.Row="3" ColumnSpacing="20" Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Folders: selected / displayed">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                <TextBlock x:Name="FolderStatus" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Files: selected / displayed">
                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                <TextBlock x:Name="FileStatus" />
            </StackPanel>
            <TextBlock x:Name="SizeStatus" Grid.Column="2" ToolTipService.ToolTip="Size: selected / displayed" />
            <TextBlock x:Name="FreeText" Grid.Column="4" />
            <ProgressBar x:Name="FreeBar" Grid.Column="5" Width="120" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
