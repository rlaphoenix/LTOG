<UserControl
    x:Class="LTOG.Gui.NoDrivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG.Gui">

    <ScrollViewer Padding="16,0">
        <StackPanel MaxWidth="560" Spacing="20" Margin="0,48" VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <FontIcon Glyph="&#xEDA2;" FontSize="72"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <FontIcon Glyph="&#xE783;" FontSize="26" Margin="0,0,-10,-6"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Grid>
                <TextBlock Text="No tape drives found" HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Connect a tape drive to get started. Follow these steps if one is already connected."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="1. Power it on" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Switch the drive on and let its self-test finish." TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE71B;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="2. Check the connection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Check the SAS, FC or USB cable and the host adapter." TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE90F;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="3. Install the tape driver" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Install the vendor's LTO driver (HPE, IBM, Quantum...)." TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>

            <Button Content="Open Device Manager" HorizontalAlignment="Center" Click="DeviceManager_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
